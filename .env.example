# ============================================
# HR SaaS 平台 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入真实值

# 数据库 (Supabase / PostgreSQL)
# Supabase 连接字符串格式:
#   postgresql://postgres.[项目ID]:[数据库密码]@aws-0-ap-southeast-1.pooler.supabase.co:6543/postgres
# 本地 PostgreSQL:
#   postgresql://用户名:密码@localhost:5432/hrsaas
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth.js 认证
# 生成方式: openssl rand -base64 32
AUTH_SECRET="生成一个随机密钥"
AUTH_URL="https://你的域名.com"

# 应用
NEXT_PUBLIC_APP_URL="https://你的域名.com"
